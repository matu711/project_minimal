# Allow only the tuning sources into the image; never send local data or secrets.
**
!Dockerfile
!requirements.lock
!SOURCE_PROVENANCE.md
!openpi/
openpi/*
!openpi/pyproject.toml
!openpi/LICENSE*
!openpi/src/
!openpi/src/**
!openpi/packages/
openpi/packages/*
!openpi/packages/openpi-client/
!openpi/packages/openpi-client/**
!openpi/scripts/
openpi/scripts/*
!openpi/scripts/__init__.py
!openpi/scripts/compute_norm_stats.py
!openpi/custom_scripts/
openpi/custom_scripts/*
!openpi/custom_scripts/train.py
!conversion/
!conversion/**
!training/
!training/**
!configs/
!configs/**
**/__pycache__
**/*test*.py

# Experiment-specific local configs are not part of the shared image.
configs/*/dnp*.yaml
